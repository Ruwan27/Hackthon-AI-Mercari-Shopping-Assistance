# ── LLM (OpenAI-compatible: works with OpenAI itself or any gateway) ─
# Both a key and a base URL are always required, plus a MODEL name that
# the chosen base URL actually serves.
#
# Using OpenAI directly:
#   AIM_API_KEY=sk-...
#   AIM_BASE_URL=https://api.openai.com/v1
#   MODEL=gpt-4o
#
# Using an OpenAI-compatible gateway: point AIM_BASE_URL at it and set
# MODEL to whatever model name that gateway exposes.
AIM_API_KEY=
AIM_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o

# ── Marketplace backend ────────────────────────────────────────────
# Which catalog the agent searches: "mercari" (default) or "rakuten".
# Mercari needs NO API keys — it mints its own DPoP token per request.
SEARCH_BACKEND=mercari

# Mercari offline/demo insurance for a live presentation: set to 1 to serve
# a captured snapshot of real Mercari results (backend/mercari_snapshot.json)
# through the exact same code path, in case the venue blocks api.mercari.jp.
MERCARI_DEMO_MODE=0

# ── Rakuten Ichiba API (only if SEARCH_BACKEND=rakuten) ─────────────
# Free registration: https://webservice.rakuten.co.jp/
# Create an app, then copy BOTH values from its settings page.
# applicationId is a UUID; accessKey starts with "pk_".
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# No Rakuten keys yet? Set this to 1 to run the whole agent on built-in
# fixtures (backend/demo_fixtures.py) instead of the live catalog.
# The two keys above are then not required, and the UI shows a demo banner.
# The products are INVENTED — turn this off once your keys work.
RAKUTEN_DEMO_MODE=0
